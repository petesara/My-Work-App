{
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "Bash(git push*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(npm run build)",
      "Bash(npm run dev)",
      "Bash(npm install*)",
      "Bash(find src*)",
      "Bash(find worker*)",
      "Bash(grep -r* src*)",
      "Bash(ls*)",
      "Bash(wc -l src*)"
    ],
    "deny": [
      "Bash(*historical_data.json*)"
    ]
  }
}
